# ════════════════════════════════════════════════════════════════════════════
#  Credentials — only needed for the automatic scraper (scripts/fetch.py).
#  If you download statements yourself and use scripts/report.py, leave blank.
# ════════════════════════════════════════════════════════════════════════════

# ── Your bank account ────────────────────────────────────────────────────────
# BANK_PROVIDER: one of  leumi | hapoalim
BANK_PROVIDER=hapoalim
# BANK_USER:  Leumi → site username    |  Hapoalim → userCode
BANK_USER=
BANK_PASSWORD=

# ── Your credit card ─────────────────────────────────────────────────────────
# CARDS_PROVIDER: one of  isracard | cal | leumi
CARDS_PROVIDER=isracard
# CARDS_USER:  Isracard → Israeli ID (ת"ז)  |  Cal/Leumi → site username
CARDS_USER=
CARDS_PASSWORD=
# CARDS_CARD6:  Isracard only — last 6 digits of the card
CARDS_CARD6=

# ── Privacy ───────────────────────────────────────────────────────────────
# Comma-separated tokens to strip from transaction descriptions: the account
# owner's name (the bank embeds it in the "purpose" field) plus any noise
# tokens you want gone. Whole-word match only.
# National-ID ("מזהה 123456789"), order ("הזמנה ...") and account ("מח-ן:...")
# numbers are always removed automatically. Leave empty to disable.
# Example: REDACT_NAMES=<surname>,<firstname>
REDACT_NAMES=

# ── Email (optional — only needed for --email flag) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                 # login for the SMTP server (e.g. you@gmail.com)
SMTP_PASSWORD=             # app password, NOT your normal account password
# EMAIL_FROM: address shown as "From". Defaults to SMTP_USER if empty.
# To use a Firefox Relay mask here, first add it as a verified "send mail as"
# alias in your Gmail account — otherwise Gmail rewrites it back to SMTP_USER.
EMAIL_FROM=
# EMAIL_TO: recipient. Optional — defaults to the sender (sends to yourself).
EMAIL_TO=
